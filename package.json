{
  "name": "fio-focus-ai",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "workspaces": [
    "extension",
    "worker"
  ],
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "npm run dev -w extension",
    "dev:worker": "npm run dev -w worker",
    "prepare": "npm run prepare -w extension",
    "typecheck": "npm run typecheck -w extension && npm run typecheck -w worker",
    "test": "vitest run",
    "build": "npm run build -w extension && npm run build -w worker",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm test && npm run build",
    "audit": "npm audit"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "^22.15.0",
    "typescript": "~5.9.3",
    "vitest": "5.1.0",
    "jsdom": "^26.1.0",
    "vite": "8.3.5"
  },
  "overrides": {
    "@vitejs/plugin-react": "6.0.5"
  }
}
